				<aux x="488.625" y="591.5" name="normal lifespan"/>
				<aux x="393.625" y="214.5" name="carrying capacity"/>
				<aux x="403.625" y="373.5" name="relative food availability"/>
				<aux x="245.625" y="384.5" name="effect of food on births"/>
				<aux x="562.625" y="361.5" name="effect of food on deaths"/>
				<flow label_side="bottom" x="330.625" y="531.5" name="births">
					<pts>
						<pt x="268.125" y="531.5"/>
						<pt x="393.125" y="531.5"/>
					</pts>
				</flow>
				<flow label_side="bottom" x="488.625" y="531.5" name="deaths">
					<pts>
						<pt x="438.125" y="531.5"/>
						<pt x="563.125" y="531.5"/>
					</pts>
				</flow>
				<stock x="415.625" y="531.5" name="Rabbits"/>
				<connector uid="1" angle="220">
					<from>Rabbits</from>
					<to>births</to>
				</connector>
				<connector uid="2" angle="90">
					<from>normal_birth_fraction</from>
					<to>births</to>
				</connector>
				<connector uid="3" angle="325.038">
