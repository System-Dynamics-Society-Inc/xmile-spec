	<default_format/>
	<model_units>
		<unit name="Dimensionless">
			<eqn>1</eqn>
			<alias>dmnl</alias>
			<alias>unitless</alias>
			<alias>fraction</alias>
		</unit>
		<unit name="Months">
			<eqn/>
			<alias>mo</alias>
			<alias>month</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<aux name="carrying capacity" ai_state="C">
				<doc>The maximum sustainable rabbit population supported by the field&apos;s resources.</doc>
				<eqn>50</eqn>
				<units>rabbits</units>
			</aux>
			<aux name="fractional birth rate" ai_state="C">
				<doc>The baseline fractional reproduction rate per rabbit under unconstrained conditions.</doc>
				<eqn>0.2</eqn>
				<units>1/Month</units>
			</aux>
			<aux name="fractional death rate" ai_state="C">
				<doc>The baseline fractional mortality rate per rabbit in the absence of crowding pressures.</doc>
				<eqn>0.05</eqn>
				<units>1/Month</units>
			</aux>
			<aux name="crowding ratio" ai_state="C">
				<doc>The ratio of the current rabbit population to environmental carrying capacity.</doc>
				<eqn>Rabbit_Population/carrying_capacity</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="effect of crowding on births" ai_state="G">
				<doc>Dimensionless multiplier representing reduced fecundity due to resource competition, dropping to zero as capacity is reached.</doc>
				<eqn>MAX(0, 1 - crowding_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="effect of crowding on deaths" ai_state="C">
				<doc>Dimensionless multiplier representing elevated mortality due to resource scarcity and crowding.</doc>
				<eqn>1 + crowding_ratio</eqn>
				<units>dimensionless</units>
			</aux>
			<flow name="births" ai_state="C">
				<doc>The rate at which new rabbits are born each month, regulated by density-dependent reproduction constraints.</doc>
				<eqn>Rabbit_Population*fractional_birth_rate*effect_of_crowding_on_births</eqn>
				<non_negative/>
				<units>rabbits/Months</units>
			</flow>
			<flow name="deaths" ai_state="C">
				<doc>The rate of rabbit mortality each month, scaling with population size and density-dependent competition.</doc>
				<eqn>Rabbit_Population*fractional_death_rate*effect_of_crowding_on_deaths</eqn>
				<non_negative/>
				<units>rabbits/Months</units>
			</flow>
			<stock name="Rabbit Population" ai_state="G">
				<doc>The total number of living rabbits in the field at any given time.</doc>
				<eqn>5</eqn>
				<inflow>births</inflow>
				<outflow>deaths</outflow>
				<units>rabbits</units>
			</stock>
			<aux name="excess deaths\nfrom crowding" ai_state="F">
				<eqn>deaths - Rabbit_Population*fractional_death_rate</eqn>
				<units>rabbits/Months</units>
			</aux>
		</variables>
