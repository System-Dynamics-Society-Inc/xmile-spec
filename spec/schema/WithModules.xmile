				<stock x="1030.13" y="406.5" name="Labor Ratio Perc"/>
				<flow label_side="bottom" x="951.125" y="406.5" name="Labor Ratio Perc net flow">
					<pts>
						<pt x="882.625" y="406.5"/>
						<pt x="1007.63" y="406.5"/>
					</pts>
				</flow>
				<connector uid="21" angle="330">
					<from>
						<alias uid="22"/>
