	</model>
	<model name="City">
		<variables>
			<aux name="declining industry demolition rate">
				<doc>	  Declining Industry Demolition Ratio</doc>
				<eqn>(0)</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="SWITCH TIME 2">
				<doc>	  SWitch Time 2</doc>
				<eqn>0</eqn>
				<units>year</units>
			</aux>
			<aux name="SWITCH TIME 7">
				<doc>	  SWitch Time 7</doc>
				<eqn>0</eqn>
				<units>year</units>
			</aux>
			<aux name="SWITCH TIME 10">
				<doc>	  Switch Time 10</doc>
				<eqn>0</eqn>
				<units>year</units>
			</aux>
			<aux name="labor training prog" access="output">
				<doc>	  Labor Training ProGram</doc>
				<eqn>LABOR_TRAINING_RATE*Labor*( IF TIME &gt;= SWITCH_TIME_2 THEN 1 ELSE 0 )</eqn>
				<units>worker/year</units>
			</aux>
			<aux name="declining industry demolition program" access="output">
				<doc>	  Declining Industry Demolition Program</doc>
				<eqn>declining_industry_demolition_rate*Declining_Industry*( IF TIME &gt;= SWITCH_TIME_7 THEN 1 ELSE 0 )</eqn>
				<units>production unit/year</units>
			</aux>
			<aux name="low cost hous prog" access="output">
				<doc>	  Low Cost Housing Program</doc>
				<eqn>low_cost_housing_constr_des*labor_construction_ratio</eqn>
				<units>housing unit/year</units>
			</aux>
			<aux name="low cost housing constr des" access="output">
				<doc>	   Low Cost Housing Construction Desired</doc>
				<eqn>low_cost_housing_prog_coeff*Underemployed*worker_housing_land_mult*( IF TIME &gt;= SWITCH_TIME_10 THEN 1 ELSE 0 )</eqn>
				<units>housing unit/year</units>
			</aux>
			<aux name="low cost housing prog coeff">
				<doc>	  Low Cost Housing Program Coefficient</doc>
				<eqn>(0)</eqn>
				<units>housing unit/(worker*year)</units>
			</aux>
			<aux name="LABOR TRAINING RATE">
				<doc>	  Labor Training Rate</doc>
				<eqn>0</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="SWITCH TIME 5">
				<doc>	  SWitch Time 5</doc>
				<eqn>0</eqn>
				<units>year</units>
			</aux>
			<aux name="underemp to labor net">
				<doc>	  Underemployed to Labor Net
	~	:SUPPLEMENTARY</doc>
				<eqn>underemp_to_labor-labor_to_underemp</eqn>
				<units>worker/year</units>
			</aux>
			<aux name="SWITCH TIME 9">
				<doc>	  SWitch Time 9</doc>
				<eqn>0</eqn>
				<units>year</units>
			</aux>
			<aux name="underemployed job program" access="output">
				<doc>	  Underemployed Job Program</doc>
				<eqn>underemp_job_program_coeff*Underemployed*( IF TIME &gt;= SWITCH_TIME_9 THEN 1 ELSE 0 )</eqn>
				<units>worker</units>
			</aux>
			<aux name="premium housing construction ratio">
				<doc>	  Premium Housing Construction Ratio</doc>
				<eqn>0</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="NEW ENTERPRISE CONSTR RATE">
				<doc>	  New Enterprise Construction Rate</doc>
				<eqn>(0)</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="tax per cap subsidy" access="output">
				<doc>	  Tax Per Capita Subsidy Program</doc>
				<eqn>tax_per_cap_subsidy_size*( IF TIME &gt;= SWITCH_TIME_8 THEN 1 ELSE 0 )</eqn>
				<units>$/(person*year)</units>
			</aux>
			<aux name="SWITCH TIME 3">
				<doc>	  SWitch Time 3</doc>
				<eqn>0</eqn>
				<units>year</units>
			</aux>
			<aux name="premium housing const prog" access="output">
				<doc>	  Premium Housing Construction Program</doc>
				<eqn>premium_housing_construction_ratio*Premium_Housing*premium_housing_land_mult*( IF TIME &gt;= SWITCH_TIME_3 THEN 1 ELSE 0 )</eqn>
				<units>housing unit/year</units>
			</aux>
			<aux name="SLUM HOUSING DEMOLITION RATE">
				<doc>	  Slum Housing Demolition Rate</doc>
				<eqn>(0)</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="slum housing demolition program" access="output">
				<doc>	  Slum Housing Demolition Program</doc>
				<eqn>SLUM_HOUSING_DEMOLITION_RATE*Underemp_Housing*( IF TIME &gt;= SWITCH_TIME_5 THEN 1 ELSE 0 )</eqn>
				<units>housing unit/year</units>
			</aux>
			<aux name="SWITCH TIME 6">
				<doc>	  SWitch Time 6</doc>
				<eqn>0</eqn>
				<units>year</units>
			</aux>
			<aux name="SWITCH TIME 1">
				<doc>	  SWitch Time 1</doc>
				<eqn>0</eqn>
				<units>year</units>
			</aux>
			<aux name="worker housing const prog" access="output">
				<doc>	   Worker Housing Construction Program</doc>
				<eqn>WORKER_HOUSING_CONSTR_RATIO*housing_units_total*worker_housing_land_mult*( IF TIME &gt;= SWITCH_TIME_4 THEN 1 ELSE 0 )</eqn>
				<units>housing unit/year</units>
			</aux>
			<aux name="SWITCH TIME 8">
				<doc>	  SWitch Time 8</doc>
				<eqn>0</eqn>
				<units>year</units>
			</aux>
			<aux name="new enterprise construction program" access="output">
				<doc>	   New Enterprise Construction Program</doc>
				<eqn>NEW_ENTERPRISE_CONSTR_RATE*production_units_total*enterprise_land_mult*( IF TIME &gt;= SWITCH_TIME_6 THEN 1 ELSE 0 )</eqn>
				<units>production unit/year</units>
			</aux>
			<aux name="tax per cap subsidy size">
				<doc>	  Tax Per Capita Subsidy</doc>
				<eqn>0</eqn>
				<units>$/(person*year)</units>
			</aux>
			<aux name="SWITCH TIME 4">
				<doc>	  SWitch Time 4</doc>
				<eqn>0</eqn>
				<units>year</units>
			</aux>
			<aux name="underemp training prog" access="output">
				<doc>	  Underemployed Training Program</doc>
				<eqn>underemp_training_rate*Underemployed*( IF TIME &gt;= SWITCH_TIME_1 THEN 1 ELSE 0 )</eqn>
				<units>worker/year</units>
			</aux>
			<aux name="underemp training rate">
				<doc>	  Underemployed Training Rate</doc>
				<eqn>(0)</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="WORKER HOUSING CONSTR RATIO">
				<doc>	  Worker Housing Construction Ratio</doc>
				<eqn>0</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="underemp job program coeff">
				<doc>	  Underemployed Job Program Coefficient</doc>
				<eqn>(0)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor construction ratio" access="input">
				<units>dimensionless</units>
			</aux>
			<stock name="Underemployed" access="input">
				<units>worker</units>
			</stock>
			<aux name="worker housing land mult" access="input">
				<units>dimensionless</units>
			</aux>
			<stock name="Labor" access="input">
				<units>worker</units>
			</stock>
			<stock name="Declining Industry" access="input">
				<units>production unit</units>
			</stock>
			<stock name="Premium Housing" access="input">
				<units>housing unit</units>
			</stock>
