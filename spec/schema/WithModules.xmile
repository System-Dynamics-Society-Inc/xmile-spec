	<model name="Manager">
		<variables>
			<stock name="Manager Professional" access="output">
				<doc>	  Manager-Professionals</doc>
				<eqn>3900</eqn>
				<inflow>Manager_Professional_flow</inflow>
				<inflow>manager_prof_birth</inflow>
				<inflow>manager_prof_arrivals</inflow>
				<outflow>manager_prof_depart</outflow>
				<units>worker</units>
			</stock>
			<aux name="manager prof arriv hous mult">
				<doc>	  Manager-professional Arrivals from Housing
		      Multiplier</doc>
				<eqn>LOOKUP(manager_prof_arriv_housing_mult_tab, manager_prof_hous_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="manager prof arriv housing mult tab">
				<doc>	  Manager-professional Arrivals from Housing
		      Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.05" max="1.3"/>
					<xpts>0,0.5,1,1.5,2,2.5,3</xpts>
					<ypts>1.3,1.2,1,0.5,0.2,0.1,0.05</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="manager prof arriv pop mult tab">
				<doc>	  Manager-professional Arrivals from
		      Population Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.3" max="1.3"/>
					<xpts>0,0.02,0.04,0.06,0.08,0.1</xpts>
					<ypts>0.3,0.7,1,1.2,1.3,1.3</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="manager prof arriv tax mult tab">
				<doc>	  Manager-professional Arrival from Tax 
		      Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.3" max="1.4"/>
					<xpts>-2,0,2,4</xpts>
					<ypts>1.4,1,0.7,0.3</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="manager prof arriv tax mult">
				<doc>	  Manager-professional Arrival from Tax 
		      Multiplier</doc>
				<eqn>LOOKUP(manager_prof_arriv_tax_mult_tab, 1.44*LN(tax_ratio))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="manager prof arriv job mult">
				<doc>	  Manager-professional Arrival from Jobs 
		      Multiplier</doc>
				<eqn>LOOKUP(manager_prof_arriv_job_mult_tab, manager_job_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="manager prof hous ratio" access="output">
				<doc>	  Manager-professional Housing Ration</doc>
				<eqn>(Manager_Professional*manager_prof_family_size)/(Premium_Housing*premium_housing_pop_dens)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="manager prof arriv job mult tab">
				<doc>	  Manager-professional Arrival from Jobs 
		      Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.05" max="2.7"/>
					<xpts>0,0.25,0.5,0.75,1,1.25,1.5,1.75,2</xpts>
					<ypts>2.7,2.6,2.4,2,1,0.4,0.2,0.1,0.05</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="manager prof arrival norm">
				<doc>	  Manager-professional Arrivals Normal</doc>
				<eqn>0.03</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="manager prof arriv mult">
				<doc>	  Manager-professional Arrival Multiplier</doc>
				<eqn>manager_prof_arriv_job_mult*manager_prof_arriv_pop_mult*manager_prof_arriv_tax_mult*manager_prof_arriv_hous_mult*manager_prof_arriv_factor</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="manager prof arriv pop mult">
				<doc>	  Manager-professional Arrivals from
		      Population Multiplier</doc>
				<eqn>LOOKUP(manager_prof_arriv_pop_mult_tab, manager_prof_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<stock name="Manager Prof Arriv Mult Perc">
				<doc>	  Manager-professional Arrival Multiplied 
		      Percieved</doc>
				<eqn>1</eqn>
				<inflow>Manager_Prof_Arriv_Mult_Perc_net_flow</inflow>
				<units>dimensionless</units>
			</stock>
			<aux name="manager prof arriv mult perc time">
				<doc>	  Manager-professional Arrival Multiplier
		      Perception Time</doc>
				<eqn>10</eqn>
				<units>year</units>
			</aux>
			<aux name="manager prof arriv factor">
				<doc>	  Manager-professional Arrival Factor</doc>
				<eqn>1</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="manager prof ratio" access="output">
				<doc>	  Manager-professional Population Ratio</doc>
				<eqn>Manager_Professional/(Labor+Underemployed)</eqn>
				<units>dimensionless</units>
			</aux>
			<flow name="manager prof arrivals">
				<doc>	  Manager-professional Arrivals</doc>
				<eqn>manager_prof_arrival_norm*Manager_Professional*Manager_Prof_Arriv_Mult_Perc</eqn>
				<units>worker/year</units>
			</flow>
			<aux name="manager prof birth rate">
				<doc>	  Manager-Professional Birth Rate</doc>
				<eqn>0.0075</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="manager prof depart mult">
				<doc>	  Manager-professional Departures Multiplier</doc>
				<eqn>LOOKUP(manager_prof_depart_mult_tab, 1.44*LN(manager_prof_arriv_mult))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="manager prof depart mult tab">
				<doc>	  Manager-professional Departures Multiplier
		      Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.125" max="8"/>
					<xpts>-3,-2,-1,0,1,2,3</xpts>
					<ypts>8,4,2,1,0.5,0.25,0.125</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="premium housing pop dens">
				<doc>	  Premium Housing Population Density</doc>
				<eqn>3</eqn>
				<units>person/housing unit</units>
			</aux>
			<flow name="manager prof depart">
				<doc>	  Manaeger-professional Departures</doc>
				<eqn>manager_prof_depart_norm*Manager_Professional*manager_prof_depart_mult</eqn>
				<units>worker/year</units>
			</flow>
			<aux name="manager prof depart norm">
				<doc>	  Manager Departures Normal</doc>
				<eqn>0.02</eqn>
				<units>fraction/year</units>
			</aux>
			<flow name="manager prof birth">
				<doc>	  Manager-Professional Births</doc>
				<eqn>Manager_Professional*manager_prof_birth_rate</eqn>
				<units>worker/year</units>
			</flow>
			<flow name="Manager Prof Arriv Mult Perc net flow">
				<eqn>(manager_prof_arriv_mult-Manager_Prof_Arriv_Mult_Perc)/manager_prof_arriv_mult_perc_time</eqn>
				<units>fraction/year</units>
			</flow>
			<flow name="Manager Professional flow">
				<eqn>labor_to_manager</eqn>
				<units>worker/year</units>
			</flow>
			<stock name="Underemployed" access="input">
				<units>worker</units>
			</stock>
			<stock name="Labor" access="input">
				<units>worker</units>
			</stock>
			<stock name="Premium Housing" access="input">
				<units>housing unit</units>
			</stock>
			<aux name="tax ratio" access="input">
				<units>dimensionless</units>
			</aux>
			<aux name="manager job ratio" access="input">
				<units>dimensionless</units>
			</aux>
			<aux name="labor to manager" access="input">
				<units>worker/year</units>
			</aux>
			<aux name="manager prof family size" access="input">
				<units>person/worker</units>
			</aux>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1122" page_height="793" isee:page_cols="2" isee:page_rows="2" zoom="40" isee:popup_graphs_are_comparative="true" isee:enable_non_negative_highlights="false" type="stock_flow">
