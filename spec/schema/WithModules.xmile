	<model name="Decline">
		<variables>
			<stock name="Declining Industry" access="output">
				<doc>	  Declining Industry</doc>
				<eqn>100</eqn>
				<inflow>Declining_Industry_flow</inflow>
				<outflow>declining_industry_demise</outflow>
				<units>production unit</units>
			</stock>
			<aux name="declining industry demise norm">
				<doc>	  Declining Industry Decline Normal</doc>
				<eqn>0.03</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="declining industry from enterprise mult tab">
				<doc>	  Declining Industry from Enterprise Multiplier 
		      Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.4" max="4"/>
					<xpts>-3,-2,-1,0,1,2,3</xpts>
					<ypts>0.4,0.5,0.7,1,1.6,2.4,4</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="declining industry demise mult">
				<doc>	  Declining Industry Decline Multiplier</doc>
				<eqn>declining_industry_from_enterprise_mult*declining_industry_from_land_mult*declining_industry_decline_factor</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="declining industry from land mult">
				<doc>	  Declining Industry from Land Multiplier</doc>
				<eqn>LOOKUP(declining_industry_from_land_mult_tab, land_fraction_occupied)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="declining industry from land mult tab">
				<doc>	  Declining Industry from Land Multiplier
		      Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="1" max="6"/>
					<xpts>0.8,0.85,0.9,0.95,1</xpts>
					<ypts>1,1.2,1.6,2.2,6</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<flow name="declining industry demise">
				<doc>	  Declining Industry Decline</doc>
				<eqn>(declining_industry_demise_norm*Declining_Industry*declining_industry_demise_mult)+declining_industry_demolition_program</eqn>
				<units>production unit/year</units>
			</flow>
			<aux name="declining industry decline factor">
				<doc>	  Declining Industry Decline Factor</doc>
				<eqn>1</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="declining industry from enterprise mult">
				<doc>	  Declining Undustry from Enterprise Multiplier</doc>
				<eqn>LOOKUP(declining_industry_from_enterprise_mult_tab, 1.44*LN(enterprise_multiplier))</eqn>
				<units>dimensionless</units>
			</aux>
			<flow name="Declining Industry flow">
				<eqn>mature_business_decline</eqn>
				<units>production unit/year</units>
			</flow>
			<aux name="declining industry demolition program" access="input">
				<units>production unit/year</units>
			</aux>
			<aux name="mature business decline" access="input">
				<units>production unit/year</units>
			</aux>
			<aux name="enterprise multiplier" access="input">
				<units>dimensionless</units>
			</aux>
			<aux name="land fraction occupied" access="input">
				<units>fraction</units>
			</aux>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1122" page_height="793" isee:page_cols="2" isee:page_rows="2" zoom="40" isee:popup_graphs_are_comparative="true" isee:enable_non_negative_highlights="false" type="stock_flow">
				<stock x="922.125" y="658.5" name="Declining Industry"/>
				<flow label_side="bottom" x="843.125" y="658.5" name="Declining Industry flow">
					<pts>
