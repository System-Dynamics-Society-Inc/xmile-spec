	<model name="Underemp_Housing1">
		<variables>
			<stock name="Underemp Housing" access="output">
				<doc>	  Underemployed Housing</doc>
				<eqn>1100</eqn>
				<inflow>Underemp_Housing_flow</inflow>
				<inflow>Underemp_Housing_flow_1</inflow>
				<outflow>slum_housing_demolition</outflow>
				<units>housing unit</units>
			</stock>
			<aux name="slum housing demolition mult">
				<doc>	  Slum Housing Demolition Multiplier</doc>
				<eqn>slum_housing_abandoned_mult*slum_housing_land_mult*slum_housing_demolitin_factor</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="slum housing demolitin factor">
				<doc>	  Slum Housing Demolition Factor</doc>
				<eqn>1</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="slum housing land mult">
				<doc>	  Slum Housing from Land Multiplier</doc>
				<eqn>LOOKUP(slum_housing_land_mult_tab, land_fraction_occupied)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="slum housing abandomed mult tab">
				<doc>	  Slum Housing Abandoned Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.4" max="3.6"/>
					<xpts>0,0.5,1,1.5,2</xpts>
					<ypts>3.6,2,1,0.6,0.4</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="slum housing abandoned mult">
				<doc>	  Slum Housing Abandoned Multiplier</doc>
				<eqn>LOOKUP(slum_housing_abandomed_mult_tab, underemp_housing_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<flow name="slum housing demolition">
				<doc>	  Slum Housing Demolition</doc>
				<eqn>(slum_housing_demolition_norm*Underemp_Housing*slum_housing_demolition_mult)+slum_housing_demolition_program</eqn>
				<units>housing unit/year</units>
			</flow>
			<aux name="slum housing demolition norm">
				<doc>	  Slum Housing Demolition Normal</doc>
				<eqn>0.02</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="slum housing land mult tab">
				<doc>	  Slum Housing from Land Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="1" max="6"/>
					<xpts>0.8,0.85,0.9,0.95,1</xpts>
					<ypts>1,1.2,1.6,2.2,6</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<flow name="Underemp Housing flow">
				<eqn>worker_housing_obsolescence</eqn>
				<units>housing unit/year</units>
			</flow>
			<flow name="Underemp Housing flow 1">
				<eqn>low_cost_hous_prog</eqn>
				<units>housing unit/year</units>
			</flow>
			<aux name="low cost hous prog" access="input">
				<units>housing unit/year</units>
			</aux>
			<aux name="slum housing demolition program" access="input">
				<units>housing unit/year</units>
			</aux>
			<aux name="land fraction occupied" access="input">
				<units>fraction</units>
			</aux>
			<aux name="underemp housing ratio" access="input">
				<units>dimensionless</units>
			</aux>
			<aux name="worker housing obsolescence" access="input">
				<units>housing unit/year</units>
			</aux>
		</variables>
