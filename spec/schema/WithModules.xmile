	<model name="Land">
		<variables>
			<aux name="housing units total" access="output">
				<doc>	  Housing Units Total</doc>
				<eqn>Premium_Housing+Worker_Housing+Underemp_Housing</eqn>
				<units>housing unit</units>
			</aux>
			<aux name="production units total" access="output">
				<doc>	  Production Units Total</doc>
				<eqn>New_Enterprise+Mature_Business+Declining_Industry</eqn>
				<units>production unit</units>
			</aux>
			<aux name="land fraction occupied" access="output">
				<doc>	  Land Fraction Occupied</doc>
				<eqn>(housing_units_total*land_per_house+production_units_total*land_per_production_unit)/TOTAL_LAND_AREA</eqn>
				<units>fraction</units>
			</aux>
			<aux name="land per production unit">
				<doc>	  Land Per Production unit</doc>
				<eqn>0.2</eqn>
				<units>acres/production unit</units>
			</aux>
			<aux name="TOTAL LAND AREA">
				<doc>	  total land AREA</doc>
				<eqn>100000</eqn>
				<units>acres</units>
			</aux>
			<aux name="land per house">
				<doc>	  Land Per House</doc>
				<eqn>0.1</eqn>
				<units>acres/housing unit</units>
			</aux>
			<stock name="Declining Industry" access="input">
				<units>production unit</units>
			</stock>
			<stock name="Premium Housing" access="input">
				<units>housing unit</units>
			</stock>
			<stock name="Underemp Housing" access="input">
				<units>housing unit</units>
			</stock>
			<stock name="New Enterprise" access="input">
				<units>production unit</units>
			</stock>
			<stock name="Mature Business" access="input">
				<units>production unit</units>
			</stock>
			<stock name="Worker Housing" access="input">
				<units>housing unit</units>
			</stock>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1122" page_height="793" isee:page_cols="2" isee:page_rows="2" zoom="60" isee:popup_graphs_are_comparative="true" isee:enable_non_negative_highlights="false" type="stock_flow">
				<aux x="681.625" y="522.5" name="housing units total"/>
