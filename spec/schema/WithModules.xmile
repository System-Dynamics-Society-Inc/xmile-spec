	<model name="Mature">
		<variables>
			<flow name="mature business decline" access="output">
				<doc>	  Mature Business Decline</doc>
				<eqn>mature_business_decline_norm*Mature_Business*business_decline_mult</eqn>
				<units>production unit/year</units>
			</flow>
			<flow name="new enterprise decline" access="output">
				<doc>	  New Enterprise Decline</doc>
				<eqn>new_enterprise_decline_normal*New_Enterprise*enterprise_decline_mult</eqn>
				<units>production unit/year</units>
			</flow>
			<stock name="Mature Business" access="output">
				<doc>	  Mature Business</doc>
				<eqn>1000</eqn>
				<inflow>new_enterprise_decline</inflow>
				<outflow>mature_business_decline</outflow>
				<units>production unit</units>
			</stock>
			<aux name="business decline mult tab">
				<doc>	  Business Decline Multipler Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.4" max="2"/>
					<xpts>-3,-2,-1,0,1,2,3</xpts>
					<ypts>2,1.8,1.5,1,0.7,0.5,0.4</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="mature business decline norm">
				<doc>	  Mature Business Decline Normal</doc>
				<eqn>0.05</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="new enterprise decline normal">
				<doc>	  New Enterprise Decline Normal</doc>
				<eqn>0.08</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="business decline mult">
				<doc>	  Business Decline Multiplier</doc>
				<eqn>LOOKUP(business_decline_mult_tab, 1.44*LN(enterprise_multiplier))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="enterprise decline mult">
				<doc>	  Enterprise Decline Multiplier</doc>
				<eqn>LOOKUP(enterprise_decline_mult_tab, 1.44*LN(enterprise_multiplier))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="enterprise decline mult tab">
				<doc>	  Enterprise Decline Multipler Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.5" max="2"/>
					<xpts>-3,-2,-1,0,1,2,3</xpts>
					<ypts>2,1.8,1.5,1,0.7,0.5,0.5</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="enterprise multiplier" access="input">
				<units>dimensionless</units>
			</aux>
			<stock name="New Enterprise" access="input">
				<units>production unit</units>
			</stock>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1122" page_height="793" isee:page_cols="2" isee:page_rows="2" zoom="60" isee:popup_graphs_are_comparative="true" isee:enable_non_negative_highlights="false" type="stock_flow">
