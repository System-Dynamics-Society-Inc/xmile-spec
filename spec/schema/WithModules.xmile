	<model name="Job">
		<variables>
			<aux name="labor construction ratio" access="output">
				<doc>	  Labor Construction Ratio</doc>
				<eqn>LOOKUP(labor_construction_ratio_tab, labor_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor jobs" access="output">
				<doc>	  Labor Jobs</doc>
				<eqn>labor_desired_construct+labor_desired_industry</eqn>
				<units>worker</units>
			</aux>
			<stock name="Labor Ratio Perc" access="output">
				<doc>	  Labor Ratio Perceived</doc>
				<eqn>1</eqn>
				<inflow>Labor_Ratio_Perc_net_flow</inflow>
				<units>dimensionless</units>
			</stock>
			<aux name="underemployed jobs" access="output">
				<doc>	  Underemployed Jobs</doc>
				<eqn>labor_jobs*underemployed_labor_job_ratio+underemployed_job_program</eqn>
				<units>worker</units>
			</aux>
			<aux name="underemp ratio" access="output">
				<doc>	  Underemployed Ratio</doc>
				<eqn>Underemployed/underemployed_jobs</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor ratio" access="output">
				<doc>	  Labor Ratio</doc>
				<eqn>Labor/labor_jobs</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="worker housing constr lab">
				<doc>	  Worker Housing Constrtuction Labor</doc>
				<eqn>1</eqn>
				<units>worker*year/housing unit</units>
			</aux>
			<aux name="mature business labor">
				<doc>	  Mature Business Labor</doc>
				<eqn>15</eqn>
				<units>worker/production unit</units>
			</aux>
			<aux name="labor ratio perception time">
				<doc>	  Labor Ratio Perception Time</doc>
				<eqn>5</eqn>
				<units>year</units>
			</aux>
			<aux name="low cost housing constr lab">
				<doc>	  Low Cost Housing Constrtuction Labor</doc>
				<eqn>0.6</eqn>
				<units>worker*year/housing unit</units>
			</aux>
			<aux name="labor desired industry">
				<doc>	  Labor Desired for Industry</doc>
				<eqn>New_Enterprise*new_enterprise_labor+Mature_Business*mature_business_labor+Declining_Industry*declining_industry_labor</eqn>
				<units>worker</units>
			</aux>
			<aux name="declining industry labor">
				<doc>	  Declining Enterprise Labor</doc>
				<eqn>10</eqn>
				<units>worker/production unit</units>
			</aux>
			<aux name="premium housing constr lab">
				<doc>	  Premium Housing Constrtuction Labor</doc>
				<eqn>2</eqn>
				<units>worker*year/housing unit</units>
			</aux>
			<aux name="new enterprise constr lab">
				<doc>	  New Enterprise Construction Labor</doc>
				<eqn>20</eqn>
				<units>worker*year/production unit</units>
			</aux>
			<aux name="new enterprise labor">
				<doc>	  New Enterprise Labor</doc>
				<eqn>20</eqn>
				<units>worker/production unit</units>
			</aux>
			<aux name="underemployed labor job ratio">
				<doc>	  Underemployed Labor Job Ratio</doc>
				<eqn>LOOKUP(underemployed_labor_job_ratio_tab, labor_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor desired construct">
				<doc>	  Labor Desired for Construction</doc>
				<eqn>premium_housing_construct_desired*premium_housing_constr_lab+worker_housing_const_des*worker_housing_constr_lab+new_enterprise_construction_desired*new_enterprise_constr_lab+low_cost_housing_constr_des*low_cost_housing_constr_lab</eqn>
				<units>worker</units>
			</aux>
			<aux name="labor construction ratio tab">
				<doc>	  Labor Construction Ratio Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0" max="1.15"/>
					<xpts>0,0.5,1,1.5,2</xpts>
					<ypts>0,0.5,0.9,1.1,1.15</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="underemployed labor job ratio tab">
				<doc>	  Underemployed Labor Job Ratio Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.1" max="1.15"/>
					<xpts>0,0.5,1,1.5,2</xpts>
					<ypts>1.15,0.8,0.5,0.25,0.1</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<flow name="Labor Ratio Perc net flow">
				<eqn>(labor_ratio-Labor_Ratio_Perc)/labor_ratio_perception_time</eqn>
				<units>fraction/year</units>
			</flow>
			<stock name="Underemployed" access="input">
				<units>worker</units>
			</stock>
			<stock name="Labor" access="input">
				<units>worker</units>
			</stock>
			<aux name="low cost housing constr des" access="input">
				<units>housing unit/year</units>
			</aux>
			<stock name="Declining Industry" access="input">
				<units>production unit</units>
			</stock>
			<aux name="underemployed job program" access="input">
				<units>worker</units>
			</aux>
			<stock name="New Enterprise" access="input">
				<units>production unit</units>
			</stock>
			<aux name="new enterprise construction desired" access="input">
				<units>production unit/year</units>
			</aux>
			<aux name="premium housing construct desired" access="input">
				<units>housing unit/year</units>
			</aux>
			<aux name="worker housing const des" access="input">
				<units>housing unit/year</units>
			</aux>
			<stock name="Mature Business" access="input">
				<units>production unit</units>
			</stock>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1122" page_height="793" isee:page_cols="2" isee:page_rows="2" zoom="40" isee:popup_graphs_are_comparative="true" isee:enable_non_negative_highlights="false" type="stock_flow">
				<aux x="452.125" y="531.5" name="labor construction ratio"/>
				<aux x="254.125" y="464.5" name="labor construction ratio tab"/>
				<connector uid="1" angle="341.305">
					<from>labor_construction_ratio_tab</from>
					<to>labor_construction_ratio</to>
				</connector>
				<aux x="655.125" y="607.5" name="labor ratio"/>
				<stock x="790.125" y="498.5" name="Labor"/>
				<connector uid="2" angle="218.918">
					<from>Labor</from>
					<to>labor_ratio</to>
				</connector>
				<aux x="570.125" y="607.5" name="labor jobs"/>
				<aux x="452.125" y="775.5" name="labor desired construct"/>
				<aux x="282.125" y="814.5" name="premium housing construct desired"/>
				<connector uid="3" angle="12.9208">
