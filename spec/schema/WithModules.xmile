					<of>labor_jobs</of>
				</alias>
				<alias font_style="italic" uid="22" x="872.843" y="357.5" width="18" height="18">
					<of>labor_ratio</of>
				</alias>
			</view>
		</views>
	</model>
	<model name="Labor1">
		<variables>
			<stock name="Labor" access="output">
				<doc>	  Labor</doc>
				<eqn>14000</eqn>
				<inflow>underemp_to_labor</inflow>
				<inflow>Labor_flow</inflow>
				<inflow>labor_arrival</inflow>
				<outflow>labor_to_manager</outflow>
				<outflow>labor_departure</outflow>
				<outflow>labor_to_underemp</outflow>
				<units>worker</units>
			</stock>
			<flow name="underemp to labor" access="output">
				<doc>	  Underemployed to Labor</doc>
				<eqn>(underemp_mobility_norm*underemp_working*Underemp_Mob_Mult_Perc)+underemp_training_prog</eqn>
				<units>worker/year</units>
			</flow>
			<flow name="labor to underemp" access="output">
				<doc>	  Labor To Underemployed</doc>
				<eqn>Labor*labor_layoff_frac</eqn>
				<units>worker/year</units>
			</flow>
			<aux name="Manager Prof Jobs" access="output">
				<doc>	  Managerial and professional Jobs</doc>
				<eqn>(New_Enterprise*new_enterprise_management)+(Mature_Business*mature_business_management)+(Declining_Industry*declining_industry_management)</eqn>
				<units>worker</units>
			</aux>
			<aux name="manager job ratio" access="output">
				<doc>	  Manager job Ratio</doc>
				<eqn>Manager_Professional/Manager_Prof_Jobs</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor arrival jobs mult">
				<doc>	  Labor Arrival from Jobs Multiplier</doc>
				<eqn>LOOKUP(labor_arrival_jobs_mult_tab, labor_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor arrival housing mult tab">
				<doc>	  Labor Arrival from Housing Multiplier</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.05" max="1.3"/>
					<xpts>0,0.5,1,1.5,2,2.5,3</xpts>
					<ypts>1.3,1.2,1,0.5,0.2,0.1,0.05</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<flow name="labor departure">
				<doc>	  Labor Departure</doc>
				<eqn>labor_daparture_normal*Labor*labor_daparture_mult</eqn>
				<units>worker/year</units>
			</flow>
			<aux name="declining industry management">
				<doc>	  Declining Industry Management</doc>
				<eqn>1</eqn>
				<units>worker/production unit</units>
			</aux>
			<aux name="labor birth">
				<doc>	  Labor Births</doc>
				<eqn>Labor*labor_birth_rate</eqn>
				<units>worker/year</units>
			</aux>
			<flow name="labor arrival">
				<doc>	  Labor Arrivals</doc>
				<eqn>labor_arrival_normal*Labor*Labor_Arrival_Mult_Perc</eqn>
				<units>worker/year</units>
			</flow>
			<aux name="labor arrival jobs mult tab">
				<doc>	  Labor Arrival from Jobs Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.05" max="2.6"/>
					<xpts>0,0.25,0.5,0.75,1,1.25,1.5,1.75,2</xpts>
					<ypts>2.6,2.6,2.4,1.8,1,0.4,0.2,0.1,0.05</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="labor arrival mult">
				<doc>	  Labor Arrival Multiplier</doc>
				<eqn>labor_arrival_jobs_mult*labor_arrival_underemp_mult*labor_arrival_tax_mult*labor_arrival_housing_mult*labor_arrival_factor</eqn>
				<units>dimensionless</units>
			</aux>
			<flow name="labor to manager" access="output">
				<doc>	  Labor To Manager</doc>
				<eqn>labor_to_manager_norm*Labor*Labor_Mob_Mult_Perc+labor_training_prog</eqn>
				<units>worker/year</units>
			</flow>
			<aux name="labor arrival normal">
				<doc>	  Labor Arrivals Normal</doc>
				<eqn>0.03</eqn>
				<units>fraction/year</units>
			</aux>
			<stock name="Labor Arrival Mult Perc">
				<doc>	  Labor Arrival Multiplier Perceived</doc>
				<eqn>1</eqn>
				<inflow>Labor_Arrival_Mult_Perc_net_flow</inflow>
				<units>dimensionless</units>
			</stock>
			<aux name="labor arrival factor">
				<doc>	  Labor Arrival Factor</doc>
				<eqn>1</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor arrival housing mult">
				<doc>	  Labor Arrival from Housing Multiplier</doc>
				<eqn>LOOKUP(labor_arrival_housing_mult_tab, labor_housing_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor housing ratio" access="output">
				<doc>	  Labor Housing Ratio</doc>
				<eqn>(Labor*labor_family_size)/(Worker_Housing*worker_housing_pop_density)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="worker housing pop density">
				<doc>	  Worker Housing Population Density</doc>
				<eqn>6</eqn>
				<units>person/housing unit</units>
			</aux>
			<aux name="labor layoff frac">
				<doc>	  Labor Layoff Fraction</doc>
				<eqn>LOOKUP(labor_layoff_frac_Tab, labor_ratio)</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="labor layoff frac Tab">
				<doc>	  Labor Layoff Fraction Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0" max="0.3"/>
					<xpts>0,0.5,1,1.5,2</xpts>
					<ypts>0,0.01,0.03,0.1,0.3</ypts>
				</gf>
				<units>fraction/year</units>
			</aux>
			<aux name="labor mob mult">
				<doc>	  Labor Mobility Multiplier</doc>
				<eqn>manage_supply_mult*manage_labor_mult*labor_edu_mult*labor_mob_fact</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor supply mult tab">
				<doc>	  Labor Supply Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.2" max="2.4"/>
					<xpts>0,0.5,1,1.5,2</xpts>
					<ypts>2.4,2,1,0.4,0.2</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="labor edu mult tab">
				<doc>	  Labor Educational Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.2" max="1.7"/>
					<xpts>0,0.5,1,1.5,2,2.5,3</xpts>
					<ypts>0.2,0.7,1,1.3,1.5,1.6,1.7</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="manage labor mult tab">
				<doc>	  Manager Labor Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.2" max="1.3"/>
					<xpts>0,0.05,0.1,0.15,0.2</xpts>
					<ypts>0.2,0.7,1,1.2,1.3</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="labor edu mult">
				<doc>	  Labor Educational Multiplier</doc>
				<eqn>LOOKUP(labor_edu_mult_tab, tax_per_cap_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="manage supply mult tab">
				<doc>	  Manager Supply Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.05" max="2.3"/>
					<xpts>0,0.25,0.5,0.75,1,1.25,1.5,1.75,2</xpts>
					<ypts>2.3,2.2,2,1.6,1,0.5,0.2,0.1,0.05</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="new enterprise management">
				<doc>	  New Enterprise Management</doc>
				<eqn>4</eqn>
				<units>worker/production unit</units>
			</aux>
			<aux name="labor underemp ratio" access="output">
				<doc>	  Labor Underemployed Ration</doc>
				<eqn>Labor/Underemployed</eqn>
				<units>dimensionless</units>
			</aux>
			<stock name="Labor Mob Mult Perc">
				<doc>	  Labor Mobility Multiplier Perceived</doc>
				<eqn>1</eqn>
				<inflow>Labor_Mob_Mult_Perc_net_flow</inflow>
				<units>dimensionless</units>
			</stock>
			<aux name="labor arrival underemp mult Tab">
				<doc>	  Labor Arrivals from Underembloyed Multiplier
		      Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.4" max="1.3"/>
					<xpts>0,1,2,3,4,5</xpts>
					<ypts>0.4,0.8,1,1.2,1.3,1.3</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="labor arrival underemp mult">
				<doc>	  Labor Arrivals from Underembloyed Multiplier</doc>
				<eqn>LOOKUP(labor_arrival_underemp_mult_Tab, labor_underemp_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor daparture mult">
				<doc>	  Labor Departure Multiplier</doc>
				<eqn>LOOKUP(labor_daparture_mult_tab, 1.44*LN(labor_arrival_mult))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor mob fact">
				<doc>	  Labor Mobility Factor</doc>
				<eqn>1</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor supply mult">
				<doc>	  Labor Supply Multiplier</doc>
				<eqn>LOOKUP(labor_supply_mult_tab, labor_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor mob mult perc time">
				<doc>	  Labor Mobility Multiplier Perception Time</doc>
				<eqn>15</eqn>
				<units>year</units>
			</aux>
			<aux name="labor to manager norm">
				<doc>	  Labor to Manager Normal</doc>
				<eqn>0.02</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="labor arrival tax mult">
				<doc>	  Labor Arrivals from Tax Multiplier</doc>
				<eqn>LOOKUP(labor_arrival_tax_mult_tab, 1.44*LN(tax_ratio))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor underemp mult tab">
				<doc>	  Labor Underemployed Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.2" max="1.4"/>
					<xpts>0,1,2,3,4,5</xpts>
					<ypts>0.2,0.7,1,1.2,1.3,1.4</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="manager labor ratio">
				<doc>	  Manager Labor Ration</doc>
				<eqn>Manager_Professional/Labor</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor unedermp mult">
				<doc>	  Labor Underemployed Multiplier</doc>
				<eqn>LOOKUP(labor_underemp_mult_tab, labor_underemp_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="manage labor mult">
				<doc>	  Manager Labor Multiplier</doc>
				<eqn>LOOKUP(manage_labor_mult_tab, manager_labor_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="manage supply mult">
				<doc>	  Managment Supply Multiplier</doc>
				<eqn>LOOKUP(manage_supply_mult_tab, manager_job_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="labor arrival tax mult tab">
				<doc>	  Labor Arrivals from Tax Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.3" max="1.2"/>
					<xpts>-2,0,2,4</xpts>
					<ypts>1.2,1,0.7,0.3</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="labor arrival mult perc tab">
				<doc>	  Labor Arrival Multiplier Perception Time</doc>
				<eqn>15</eqn>
				<units>year</units>
			</aux>
			<aux name="labor daparture normal">
				<doc>	  Labor departure Normal</doc>
				<eqn>0.02</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="labor birth rate">
				<doc>	  Labor Birth Rate</doc>
				<eqn>0.01</eqn>
				<units>fraction/year</units>
			</aux>
			<aux name="labor daparture mult tab">
				<doc>	  Labor Departure Multiplier Table.</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.125" max="8"/>
					<xpts>-3,-2,-1,0,1,2,3</xpts>
					<ypts>8,4,2,1,0.5,0.25,0.125</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="underemp mob factor">
				<doc>	  Underemployed Mobility Factor</doc>
				<eqn>1</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="underemp fract working tab">
				<doc>	  Underemployed Fraction Working Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.25" max="0.9"/>
					<xpts>0,1,2,3,4</xpts>
					<ypts>0.9,0.8,0.5,0.33,0.25</ypts>
				</gf>
				<units>fraction</units>
			</aux>
			<aux name="mature business management">
				<doc>	  Mature Business Management</doc>
				<eqn>2</eqn>
				<units>worker/production unit</units>
			</aux>
			<aux name="underemp to labor perc time">
				<doc>	  Underemployed to Labor Perception Time</doc>
				<eqn>10</eqn>
				<units>year</units>
			</aux>
			<aux name="underemp mob mult">
				<doc>	  Underemployed Mobility Multiplier</doc>
				<eqn>labor_supply_mult*labor_unedermp_mult*underemp_edu_mult*underemp_mob_factor</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="underemp working">
				<doc>	  Underemployed Working</doc>
				<eqn>Underemployed*underemp_fract_working</eqn>
				<units>worker</units>
			</aux>
			<aux name="underemp edu mult">
				<doc>	  Underemployed Educational Multiplier</doc>
				<eqn>LOOKUP(underemp_edu_mult_tab, tax_per_cap_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="underemp fract working">
				<doc>	  Underemployed Fraction Working</doc>
				<eqn>LOOKUP(underemp_fract_working_tab, underemp_ratio)</eqn>
				<units>fraction</units>
			</aux>
			<aux name="underemp mob mult perc time">
				<doc>	  Underemployed Mobility Multiplier Perception
		      Time</doc>
				<eqn>10</eqn>
				<units>year</units>
			</aux>
			<aux name="underemp edu mult tab">
				<doc>	  Underemployed Educational Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.2" max="1.7"/>
					<xpts>0,0.5,1,1.5,2,2.5,3</xpts>
					<ypts>0.2,0.7,1,1.3,1.5,1.6,1.7</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="underemp mobility norm">
				<doc>	  Underemployed Mobility Normal</doc>
				<eqn>0.1</eqn>
				<units>fraction/year</units>
			</aux>
			<stock name="Underemp Mob Mult Perc">
				<doc>	  Underemployed Mobility Multiplier Percieved</doc>
				<eqn>1</eqn>
				<inflow>Underemp_Mob_Mult_Perc_net_flow</inflow>
				<units>dimensionless</units>
			</stock>
			<stock name="Underemp to Labor Perc">
				<doc>	  Underemployed to Labor Perceived</doc>
				<eqn>75</eqn>
				<inflow>Underemp_to_Labor_Perc_net_flow</inflow>
				<units>worker/year</units>
			</stock>
			<aux name="underemp mobility" access="output">
				<doc>	  Underemployed Mobility</doc>
				<eqn>Underemp_to_Labor_Perc/Underemployed</eqn>
				<units>fraction/year</units>
			</aux>
			<flow name="Labor Mob Mult Perc net flow">
				<eqn>(labor_mob_mult-Labor_Mob_Mult_Perc)/labor_mob_mult_perc_time</eqn>
				<units>fraction/year</units>
			</flow>
			<flow name="Underemp to Labor Perc net flow">
				<eqn>(underemp_to_labor-Underemp_to_Labor_Perc)/underemp_to_labor_perc_time</eqn>
				<units>worker/year/year</units>
			</flow>
			<flow name="Labor flow">
				<eqn>labor_birth</eqn>
				<units>worker/year</units>
			</flow>
			<flow name="Labor Arrival Mult Perc net flow">
				<eqn>(labor_arrival_mult-Labor_Arrival_Mult_Perc)/labor_arrival_mult_perc_tab</eqn>
				<units>fraction/year</units>
			</flow>
			<flow name="Underemp Mob Mult Perc net flow">
				<eqn>(underemp_mob_mult-Underemp_Mob_Mult_Perc)/underemp_mob_mult_perc_time</eqn>
				<units>fraction/year</units>
			</flow>
			<stock name="Underemployed" access="input">
				<units>worker</units>
			</stock>
			<aux name="labor training prog" access="input">
				<units>worker/year</units>
			</aux>
			<stock name="Declining Industry" access="input">
				<units>production unit</units>
			</stock>
			<aux name="underemp training prog" access="input">
				<units>worker/year</units>
			</aux>
			<stock name="Manager Professional" access="input">
