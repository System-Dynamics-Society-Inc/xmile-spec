	<model name="Tax">
		<variables>
			<aux name="tax ratio" access="output">
				<doc>	  Tax Ratio</doc>
				<eqn>LOOKUP(tax_ratio_table, 1.44*LN(Tax_Ratio_Needed_Perc))</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="housing assessed value">
				<doc>	  Housing Assessed value</doc>
				<eqn>premium_housing_assessed_value*Premium_Housing+worker_housing_assessed_value*Worker_Housing+underemp_housing_assessed_value*Underemp_Housing</eqn>
				<units>THOU $</units>
			</aux>
			<aux name="new enterprise assessed value">
				<doc>	  New enterprise Assessed Value</doc>
				<eqn>500</eqn>
				<units>THOU $/production unit</units>
			</aux>
			<aux name="maturre business assessed value">
				<doc>	  Mature Business Assessed Value</doc>
				<eqn>300</eqn>
				<units>THOU $/production unit</units>
			</aux>
			<aux name="declining industry assessed value">
				<doc>	  Declining Industry Assessed Value</doc>
				<eqn>100</eqn>
				<units>THOU $/production unit</units>
			</aux>
			<aux name="premium housing assessed value">
				<doc>	  Premium Housing Assessed Value</doc>
				<eqn>30</eqn>
				<units>THOU $/housing unit</units>
			</aux>
			<aux name="tax assessment norm">
				<doc>	   Tax Assessment Normal</doc>
				<eqn>50</eqn>
				<units>$/(year*THOU $)</units>
			</aux>
			<aux name="tax collection mult">
				<doc>	  Tax Collection Multiplier</doc>
				<eqn>LOOKUP(tax_collection_mult_tab, labor_underemp_ratio)</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="tax collection mult tab">
				<doc>	  Tax Collection Multiplier Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.8" max="2"/>
					<xpts>0,0.5,1,1.5,2,2.5,3</xpts>
					<ypts>2,1.6,1.3,1.1,1,0.9,0.8</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="tax spending per labor">
				<doc>	  Tax spending per Labor Person</doc>
				<eqn>200</eqn>
				<units>$/(year*person)</units>
			</aux>
			<aux name="tax collections" access="output">
				<doc>	  Tax Collections</doc>
				<eqn>assessed_value*tax_assessment_norm*tax_ratio</eqn>
				<units>$/year</units>
			</aux>
			<aux name="tax assessment indicated">
				<doc>	  Tax Assessment Indicated</doc>
				<eqn>tax_needed/assessed_value</eqn>
				<units>$/(year*THOU $)</units>
			</aux>
			<aux name="tax spending per underemp">
				<doc>	  Tax spending per Underemployed Person</doc>
				<eqn>300</eqn>
				<units>$/(year*person)</units>
			</aux>
			<aux name="tax needed">
				<doc>	  Tax Needed</doc>
				<eqn>(tax_spending_per_manager*manager_prof_family_size*Manager_Professional+tax_spending_per_labor*labor_family_size*Labor+tax_spending_per_underemp*underemp_family_size*Underemployed)*tax_collection_mult</eqn>
				<units>$/year</units>
			</aux>
			<aux name="tax ratio table">
				<doc>	  Tax Ratio Table</doc>
				<eqn>0+0</eqn>
				<gf>
					<yscale min="0.3" max="4"/>
					<xpts>-2,-1,0,1,2,3,4</xpts>
					<ypts>0.3,0.5,1,1.8,2.8,3.6,4</ypts>
				</gf>
				<units>dimensionless</units>
			</aux>
			<aux name="tax ratio needed">
				<doc>	  Tax Ratio Needed</doc>
				<eqn>tax_assessment_indicated/tax_assessment_norm</eqn>
				<units>dimensionless</units>
			</aux>
			<aux name="tax ratio needed perception time">
				<doc>	  Tax Ratio Needed Perception Time</doc>
				<eqn>30</eqn>
				<units>year</units>
			</aux>
			<aux name="tax spending per manager">
				<doc>	  Tax spending per Manager-professional Person</doc>
				<eqn>150</eqn>
				<units>$/(year*person)</units>
			</aux>
			<stock name="Tax Ratio Needed Perc">
				<doc>	  Tax Ratio Needed Perceived</doc>
				<eqn>tax_ratio_needed</eqn>
				<inflow>Tax_Ratio_Needed_Perc_net_flow</inflow>
				<units>dimensionless</units>
			</stock>
			<aux name="worker housing assessed value">
				<doc>	  Worker Housing Assessed Value</doc>
				<eqn>15</eqn>
				<units>THOU $/housing unit</units>
			</aux>
			<aux name="underemp housing assessed value">
				<doc>	  Underemployed Housing Assessed Value</doc>
				<eqn>5</eqn>
				<units>THOU $/housing unit</units>
			</aux>
			<aux name="assessed value">
				<doc>	  Assessed Value</doc>
				<eqn>(housing_assessed_value+business_assessed_value)</eqn>
				<units>THOU $</units>
			</aux>
			<aux name="business assessed value">
				<doc>	  Business Assessed Value</doc>
				<eqn>new_enterprise_assessed_value*New_Enterprise+maturre_business_assessed_value*Mature_Business+declining_industry_assessed_value*Declining_Industry</eqn>
				<units>THOU $</units>
			</aux>
			<flow name="Tax Ratio Needed Perc net flow">
				<eqn>(tax_ratio_needed-Tax_Ratio_Needed_Perc)/tax_ratio_needed_perception_time</eqn>
				<units>fraction/year</units>
			</flow>
			<stock name="Underemployed" access="input">
				<units>worker</units>
			</stock>
			<stock name="Labor" access="input">
				<units>worker</units>
			</stock>
			<stock name="Declining Industry" access="input">
				<units>production unit</units>
			</stock>
			<stock name="Premium Housing" access="input">
				<units>housing unit</units>
			</stock>
			<stock name="Underemp Housing" access="input">
				<units>housing unit</units>
			</stock>
			<aux name="underemp family size" access="input">
				<units>person/worker</units>
			</aux>
			<stock name="Manager Professional" access="input">
				<units>worker</units>
			</stock>
			<stock name="New Enterprise" access="input">
				<units>production unit</units>
			</stock>
			<stock name="Mature Business" access="input">
				<units>production unit</units>
			</stock>
			<aux name="labor underemp ratio" access="input">
				<units>dimensionless</units>
			</aux>
			<stock name="Worker Housing" access="input">
				<units>housing unit</units>
			</stock>
			<aux name="labor family size" access="input">
				<units>person/worker</units>
			</aux>
			<aux name="manager prof family size" access="input">
				<units>person/worker</units>
			</aux>
		</variables>
