	<model name="Condition">
		<variables>
			<aux name="percent underemp">
				<doc>	   The percentage of the population that is underemployed.
	~	:SUPPLEMENTARY</doc>
				<eqn>100*Underemployed*underemp_family_size/population</eqn>
				<units>Dmnl</units>
			</aux>
			<aux name="underemployed crowding">
				<doc>	   The level of crowding among the unemployed.
	~	:SUPPLEMENTARY</doc>
				<eqn>100*underemp_housing_ratio</eqn>
				<units>Dmnl</units>
			</aux>
			<aux name="unemployment rate">
				<doc>	   The unemployment rate.
	~	:SUPPLEMENTARY</doc>
				<eqn>100*(1-(labor_jobs+underemployed_jobs+Manager_Prof_Jobs)/(Labor+Manager_Professional+Underemployed))</eqn>
				<units>Dmnl</units>
			</aux>
			<stock name="Underemployed" access="input">
				<units>worker</units>
			</stock>
			<stock name="Labor" access="input">
				<units>worker</units>
			</stock>
			<aux name="population" access="input">
				<units>person</units>
			</aux>
			<aux name="underemp family size" access="input">
				<units>person/worker</units>
			</aux>
			<aux name="labor jobs" access="input">
				<units>worker</units>
			</aux>
			<stock name="Manager Professional" access="input">
				<units>worker</units>
			</stock>
			<aux name="underemp housing ratio" access="input">
				<units>dimensionless</units>
			</aux>
			<aux name="Manager Prof Jobs" access="input">
				<units>worker</units>
			</aux>
			<aux name="underemployed jobs" access="input">
				<units>worker</units>
			</aux>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1122" page_height="793" isee:page_cols="2" isee:page_rows="2" zoom="40" isee:popup_graphs_are_comparative="true" isee:enable_non_negative_highlights="false" type="stock_flow">
				<aux x="404.125" y="352.5" name="percent underemp"/>
				<stock x="455.125" y="505.5" name="Underemployed"/>
				<connector uid="1" angle="108.435">
					<from>Underemployed</from>
					<to>percent_underemp</to>
				</connector>
				<aux x="485.125" y="214.5" name="underemp family size"/>
				<connector uid="2" angle="239.589">
