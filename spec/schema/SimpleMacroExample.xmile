	<macro name="SimpleSum">
		<eqn>output</eqn>
		<parm>in1</parm>
		<parm default="0">in2</parm>
		<parm default="0">in3</parm>
		<variables>
			<aux name="in1" access="input">
				<eqn>5</eqn>
			</aux>
			<aux name="in2" access="input">
				<eqn>0</eqn>
			</aux>
			<aux name="output" access="output">
				<eqn>in2 + in1 + in3</eqn>
				<units>in1</units>
			</aux>
			<aux name="in3" access="input">
				<eqn>0</eqn>
			</aux>
		</variables>
		<view isee:show_pages="false" background="white" page_width="1122" page_height="793" isee:popup_graphs_are_comparative="true" isee:enable_non_negative_highlights="false" type="stock_flow">
