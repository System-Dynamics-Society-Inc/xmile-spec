			<isee:tag_style tag="Policy"/>
		</isee:tag_styles>
	</isee:prefs>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" max_advance_time_in_ms="0" model_stops_when_players_drop="false" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<isee:number_format_extenders/>
	<model_units>
		<unit name="People">
			<eqn/>
			<alias>person</alias>
			<alias>persons</alias>
		</unit>
		<unit name="Years">
			<eqn/>
			<alias>yr</alias>
			<alias>year</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<aux name="birth rate" ai_state="C">
				<doc>Fractional rate at which new individuals are born per year.</doc>
				<eqn>0.03</eqn>
				<units>1/year</units>
			</aux>
			<aux name="death rate" ai_state="C">
				<doc>Fractional rate at which individuals die per year.</doc>
				<eqn>0.015</eqn>
				<units>1/year</units>
			</aux>
			<flow name="births" ai_state="C">
				<doc>Total number of people born each year, increasing the population stock.</doc>
				<eqn>population*birth_rate</eqn>
				<non_negative/>
				<units>people/year</units>
			</flow>
			<flow name="deaths" ai_state="C">
				<doc>Total number of deaths each year, decreasing the population stock.</doc>
				<eqn>population*death_rate</eqn>
				<non_negative/>
				<units>people/year</units>
			</flow>
			<stock name="population" ai_state="C">
				<doc>The total number of individuals in the population.</doc>
				<eqn>1000</eqn>
				<inflow>births</inflow>
				<outflow>deaths</outflow>
				<units>people</units>
			</stock>
		</variables>
		<views>
			<view isee:show_pages="false" background="white" page_width="1122" page_height="793" isee:page_cols="2" isee:page_rows="2" isee:popup_graphs_are_comparative="true" isee:enable_non_negative_highlights="false" type="stock_flow">
				<aux x="274.5" y="293.5" name="birth rate"/>
				<aux x="432.5" y="293.5" name="death rate"/>
				<flow label_side="bottom" x="274.5" y="233.5" name="births">
					<pts>
						<pt x="212" y="233.5"/>
						<pt x="337" y="233.5"/>
					</pts>
				</flow>
				<flow label_side="bottom" x="432.5" y="233.5" name="deaths">
					<pts>
						<pt x="382" y="233.5"/>
						<pt x="507" y="233.5"/>
					</pts>
				</flow>
				<stock x="359.5" y="233.5" name="population"/>
				<connector uid="1" polarity="+" isee:polarity_placement="outside" angle="220">
					<isee:documentation>Reasoning:
A higher population generates more total births per year.

Polarity Reasoning: 
As population increases, annual births increase in the same direction.</isee:documentation>
					<isee:reasoning>A higher population generates more total births per year.</isee:reasoning>
					<isee:polarity_reasoning>As population increases, annual births increase in the same direction.</isee:polarity_reasoning>
					<from>population</from>
					<to>births</to>
				</connector>
				<connector uid="2" polarity="+" isee:polarity_placement="outside" angle="90">
					<isee:documentation>Reasoning:
A higher fractional birth rate increases total annual births.

Polarity Reasoning: 
An increase in birth rate leads to an increase in births.</isee:documentation>
					<isee:reasoning>A higher fractional birth rate increases total annual births.</isee:reasoning>
					<isee:polarity_reasoning>An increase in birth rate leads to an increase in births.</isee:polarity_reasoning>
					<from>birth_rate</from>
					<to>births</to>
				</connector>
				<connector uid="3" polarity="+" isee:polarity_placement="outside" angle="40">
					<isee:documentation>Reasoning:
A larger population results in more total annual deaths.

Polarity Reasoning: 
As population increases, annual deaths increase in the same direction.</isee:documentation>
					<isee:reasoning>A larger population results in more total annual deaths.</isee:reasoning>
					<isee:polarity_reasoning>As population increases, annual deaths increase in the same direction.</isee:polarity_reasoning>
					<from>population</from>
					<to>deaths</to>
				</connector>
				<connector uid="4" polarity="+" isee:polarity_placement="outside" angle="90">
					<isee:documentation>Reasoning:
A higher fractional death rate increases total annual deaths.

Polarity Reasoning: 
An increase in death rate leads to an increase in deaths.</isee:documentation>
					<isee:reasoning>A higher fractional death rate increases total annual deaths.</isee:reasoning>
					<isee:polarity_reasoning>An increase in death rate leads to an increase in deaths.</isee:polarity_reasoning>
					<from>death_rate</from>
					<to>deaths</to>
				</connector>
			</view>
		</views>
	</model>
</xmile>

