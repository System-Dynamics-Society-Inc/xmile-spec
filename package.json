{
  "name": "xmile-spec",
  "version": "1.1.0",
  "private": true,
  "description": "XML Interchange Language for System Dynamics (XMILE) specification",
  "scripts": {
    "build": "node tools/build.mjs spec/xmile.adoc build/xmile.html",
    "build:release": "node tools/release-build.mjs spec/xmile.adoc build/xmile-release.html",
    "lint": "node tools/lint.mjs spec",
    "validate": "node tools/validate.mjs",
    "check": "npm run lint && npm run build && npm run validate"
  },
  "devDependencies": {
    "@asciidoctor/core": "^3.0.4"
  }
}
